{
  "name": "hunt-the-code",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Put the IEEE ITS D1 database name and id here before deploying.
      "database_name": "ieee-its",
      "database_id": "REPLACE_WITH_IEEE_ITS_D1_DATABASE_ID",
      "migrations_dir": "migrations",
      // Separate tracking table so this app never clashes with other apps on the same database.
      "migrations_table": "hunt_migrations"
    }
  ]
}
